# ---------------------------------------------------------------------------
# IrieEvents environment variables
# Copy to .env (and app-specific .env files) and fill in real values.
# NEVER commit real keys. .env is gitignored.
# ---------------------------------------------------------------------------

# Supabase project (from https://app.supabase.com > Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SECRET. Server-side / admin / seed scripts only. Never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Next.js web (apps/web) --- (public vars are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Expo mobile (apps/mobile) --- (EXPO_PUBLIC_ vars are bundled into the app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Geocoding for the admin curation tool (address -> lat/lng).
# Use a provider you have a key for (e.g. Google Geocoding, Mapbox, or leave blank to enter lat/lng manually).
GEOCODER_PROVIDER=none
GEOCODER_API_KEY=
